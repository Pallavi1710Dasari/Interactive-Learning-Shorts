  "actions": {
    "enter": "the object appears (its kind's own entrance)",
    "exit": "the object fades out",
    "state": "tone and/or value change: entity_card value+tone, system_panel status+tone(+slot_value), status_pill text+tone, token_row item tones (value = comma-separated tones), big_counter value, connector tone/broken",
    "pulse": "a pulse travels / the object glows (connector, trigger_chip, system_panel, entity_card)",
    "highlight": "one part lights up: value = 1-based word (kinetic_title), line (code_window), chip (token_row), row (lookup_table), part (code_map), icon (icon_row)",
    "type": "code_window types its lines in, one by one",
    "count": "big_counter counts up from 0 to its value",
    "scramble": "kinetic_title's words settle from random characters",
    "stagger": "takeaway_list rows appear one by one",
    "stamp": "the stamp slams in (at most one per reel; coral, so failure beats only)"
