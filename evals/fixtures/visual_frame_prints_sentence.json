  "question": "Why does an operating system use paging instead of contiguous allocation?",
  "estimated_seconds": 30.0,
  "beats": [
    {
      "speaker": "interviewer",
      "line": "Why does an operating system use paging instead of contiguous allocation?",
      "on_screen": "Which rule wins?",
      "visual_ref": "d_one"
    },
    {
      "speaker": "student",
      "line": "Contiguous allocation forces every process to occupy one unbroken block.",
      "on_screen": "Step 1",
      "visual_ref": "d_two",
      "source_quote": "The components are compared left to right and the first difference decides the winner"
    },
    {
      "speaker": "student",
      "line": "Paging removes that requirement for contiguity entirely.",
      "on_screen": "Step 2",
      "visual_ref": "d_three",
      "source_quote": "The components are compared left to right and the first difference decides the winner"
    },
    {
      "speaker": "student",
      "line": "So any page may be placed in any free frame.",
      "on_screen": "Step 3",
      "visual_ref": "d_four",
      "source_quote": "The components are compared left to right and the first difference decides the winner"
    }
