.env
.env.bak*
__pycache__/
*.pyc
venv/
venv-chatterbox/
output/
web/node_modules/
web/dist/
web/.ssr/

# The 23 MB reference video stays local; its extracted frames are committed.
docs/reference/tokenization-reel.mp4

# Review artifacts (screenshots, frame sheets, clips, sweeps, sample plans)
# stay local; only each review folder's notes (README.md and other .md) are
# committed.
docs/reference/*/*
!docs/reference/*/*.md
docs/reference/**/*.mp4

# The avatar models are local files (assets/avatars/README.md says where they
# come from); the server reads them from disk.
assets/avatars/*.vrm
