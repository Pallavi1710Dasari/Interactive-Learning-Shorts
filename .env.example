# Copy to .env and fill in real keys. Never commit .env
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# ---------------------------------------------------------------------- the voice
#
# Narration is recorded once at build time and cached, never generated while someone
# is watching. Three backends, and "auto" takes the best one whose credentials work:
#
#   elevenlabs  best sounding, paid beyond a small free tier
#   kokoro      local, offline, free, no account — close to the cloud tiers
#   google      very close, ~1M free characters a month, plain API key
#   piper       local, offline, free, smaller and rougher than Kokoro
#
# Nothing here is required: with all of it blank you get Kokoro, which needs no
# signup. Check what is actually usable with:  python -m shorts.voice --check
TTS_PROVIDER=auto

ELEVENLABS_API_KEY=

# Google Cloud TTS. Create an API key in the Cloud console, enable the
# Text-to-Speech API on the project, and paste the key — no service-account JSON.
GOOGLE_TTS_API_KEY=
# GOOGLE_VOICE_INTERVIEWER=en-US-Neural2-D
# GOOGLE_VOICE_STUDENT=en-US-Neural2-F

# Kokoro. Needs `pip install kokoro-onnx`. The two model files (~330MB) download
# themselves on first use, into output/kokoro-voices. Voice prefixes: a=American,
# b=British, f=female, m=male, h=Hindi. `python -m shorts.voice --check` lists all 54.
# KOKORO_VOICE_INTERVIEWER=am_michael
# KOKORO_VOICE_STUDENT=af_heart
#
# Either name can instead be a BLEND of two or more voices, weighted or not:
#
#   KOKORO_VOICE_STUDENT=af_bella+hf_beta              equal parts
#   KOKORO_VOICE_STUDENT=af_bella:0.6+hf_beta:0.4      weighted
#
# A Kokoro voice is a style tensor, not a model, so an average of two is a real
# third voice. This is how you get an accent the pack has no voice for: Kokoro has
# no Indian English, but 60% American and 40% Hindi lands close, and the ratio is a
# continuous dial. Render a ladder of ratios and pick by ear:
#   python -m shorts.voicesample --only kokoro
#
# Phonemisation, which is separate from the voice. espeak has no en-IN; en-gb is
# the only alternative English phonology and resolves some consonants differently,
# which is worth trying if stops sound muddy.
# KOKORO_LANG=en-us

# Piper. Models download themselves on first use, into output/piper-voices.
# PIPER_VOICE_INTERVIEWER=en_US-ryan-medium
# PIPER_VOICE_STUDENT=en_US-lessac-medium

# Models. IDs are gateway-specific: first-party Anthropic wants "claude-sonnet-5",
# OpenRouter wants "anthropic/claude-sonnet-5" and can also serve OpenAI and Google.
#
# Keep the generator and the judge in DIFFERENT families. A judge scoring its own
# family's writing marks it generously, and catching fabrication is why it exists.
#
# Reasoning cannot be disabled on the gpt-5 family through OpenRouter — it answers
# a 400, and llm._reasoning handles that per family. It does mean a gpt-5 generator
# has an output-token floor: roughly 3300 tokens of deliberation on every call, even
# a box-layout one. That is what MODEL_DIAGRAM below exists to route around.
MODEL_GENERATOR=claude-sonnet-5
MODEL_JUDGE=claude-opus-5
MODEL_CHEAP=claude-haiku-4-5

# The SVG drawing calls, 4-5 per short and the largest line on the bill. Defaults to
# MODEL_GENERATOR. Worth setting to a model that can turn reasoning OFF: the visual
# spec has already decided what the frame contains, so this call is formatting, not
# deliberation. Measured on one identical frame:
#     openai/gpt-5-mini             3915 out tokens  7 shapes  0 defects  37s
#     google/gemini-3.1-flash-lite   868 out tokens  6 shapes  0 defects   3s
# MODEL_DIAGRAM=google/gemini-3.1-flash-lite

# OPTIONAL — leave blank. With these empty, shorts/voice.py picks two contrasting
# voices from your own ElevenLabs library on first use and prints what it chose. Set
# them only to pin specific voices; a mistyped id is a 404 on every beat.
VOICE_INTERVIEWER=
VOICE_STUDENT=

# OPTIONAL delivery tuning. Defaults are in shorts/config.py and are already set for
# conversational speech — stability is deliberately LOW because high stability makes
# the read flat. Raise it toward 0.7 if a voice drifts on long lines.
# ELEVENLABS_MODEL=eleven_multilingual_v2   # or eleven_flash_v2_5 for speed
# VOICE_STABILITY=0.40
# VOICE_SIMILARITY=0.80
# VOICE_STYLE=0.35
# VOICE_SPEED=1.0
# VOICE_BEAT_GAP=0.45                       # silence between beats, seconds
